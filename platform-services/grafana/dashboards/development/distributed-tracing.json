{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "#5794F2",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "folder": "Stonetusker Demo",
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "grafana",
        "uid": "-- Grafana --"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 4,
      "options": {
        "content": "## Customer issue lookup\n\nEnter the customer or request correlation ID above. The trace and log panels below will narrow to that request. Leave the default `.*` to show all recent demo-service traces.\n\nFlow: issue -> correlation ID -> application log -> trace ID -> Tempo trace -> linked logs.",
        "mode": "markdown"
      },
      "title": "How to investigate a customer issue",
      "type": "text"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "query": "{ resource.service.name = \"demo-service\" && span.http.target != \"/healthz\" && span.http.target != \"/readyz\" && span.http.target != \"/metrics\" }",
          "queryType": "traceql",
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "title": "Recent traces",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 2,
      "options": {
        "deduplication": true,
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLines": true
      },
      "targets": [
        {
          "expr": "{namespace=\"demo-service-development\", app=\"demo-service\"} | json | message=\"request_completed\" | correlation_id=~\"${correlation_id}\"",
          "refId": "A"
        }
      ],
      "title": "Application events for correlation",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"demo-service\",environment=\"development\"}[5m]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "title": "Request activity during trace capture",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "stonetusker",
    "tempo",
    "tracing"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "label": "Customer/request correlation ID",
        "name": "correlation_id",
        "query": ".*",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Distributed Tracing Demo",
  "uid": "stonetusker-distributed-tracing",
  "version": 1
}
