  "description": "Buyer-facing golden-path dashboard for the TuskerBlueprint demo service. It connects release identity, RED metrics, Kubernetes health, product signals and correlated logs.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "# TuskerBlueprint Golden Path",
        "mode": "markdown"
      },
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "A value of LIVE proves Prometheus is scraping the application metric endpoint. MISSING is different from a healthy zero.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "MISSING"
                },
                "1": {
                  "color": "green",
                  "text": "LIVE"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(application_info{service=\"$service\",environment=\"$environment\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Telemetry",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Telemetry state",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The immutable Git commit SHA currently reported by the running application.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "noValue": "NO TELEMETRY"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 3
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (version) (application_info{service=\"$service\",environment=\"$environment\"}) or on() label_replace(vector(0), \"version\", \"NO TELEMETRY\", \"__name__\", \".*\")",
          "instant": true,
          "legendFormat": "{{version}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Running release",
      "type": "stat"
    },
    {
      "datasource": {
