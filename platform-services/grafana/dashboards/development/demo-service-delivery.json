        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "1000 * (histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\",environment=\"$environment\",route=~\"/api/.*\"}[$__rate_interval]))) or vector(0))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "p95 latency",
      "type": "stat"
    },
