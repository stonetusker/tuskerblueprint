        "uid": "prometheus"
      },
      "description": "Customer-facing API requests observed in the selected dashboard time range.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
