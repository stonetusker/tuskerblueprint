apiVersion: v1
kind: Secret
metadata:
  name: argocd-repository-tuskerblueprint
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository

type: Opaque

stringData:
  type: git
  url: git@github.com:stonetusker/tuskerblueprint.git
  sshPrivateKey: |
{% raw %}{{ lookup('file', lookup('env','HOME') + '/.ssh/tuskerblueprint-argocd') | indent(4) }}{% endraw %}
